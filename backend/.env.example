PORT=3000
USER_DB_PATH=data/usuarios.sqlite
FRONTEND_URL=http://localhost:5173

# Solo para probar localmente: imprime el enlace en la consola del backend.
# No usar en producción.
RECOVERY_EMAIL_MODE=console

# Para enviar correos reales, elimina/comenta RECOVERY_EMAIL_MODE y configura:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Yupay Finance <no-reply@example.com>"