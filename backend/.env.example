PORT=3000
# TS-116. Solo consulta el catálogo SQLite local; detector y cruce pendientes del equipo.
MARKET_MONITORING_ENABLED=false
MARKET_MONITORING_INTERVAL_MS=60000
# Base de datos única (usuarios, pagos, favoritos y catálogo). USER_DB_PATH se acepta por compatibilidad.
DB_PATH=data/usuarios.sqlite
FRONTEND_URL=http://localhost:5173

# Secreto compartido para recibir eventos de fallo de renovación de la pasarela.
# Genera uno distinto para cada entorno; no uses un valor de ejemplo en producción.
SUBSCRIPTION_WEBHOOK_SECRET=

# Solo para probar localmente: imprime el enlace en la consola del backend.
# No usar en producción.
RECOVERY_EMAIL_MODE=console

# Para enviar correos reales, elimina/comenta RECOVERY_EMAIL_MODE y configura:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Yupay Finance <no-reply@example.com>"
ALERT_EMAIL_JOB_ENABLED=false
